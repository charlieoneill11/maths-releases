import Mathlib.GroupTheory.Index
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

namespace Shumyatsky.Gaschutz

variable {G Q ι : Type*} [Group G] [Group Q]

def generated {T : Type*} [Group T] (v : ι → T) : Subgroup T := Subgroup.closure (Set.range v)

private theorem generated_le {v : ι → G} {H : Subgroup G} :
    generated v ≤ H ↔ ∀ i, v i ∈ H := by simp [generated, Subgroup.closure_le, Set.range_subset_iff]

private theorem generated_map (f : G →* Q) (v : ι → G) :
    (generated v).map f = generated (f ∘ v) := by
  simp only [generated, MonoidHom.map_closure, Set.range_comp]

open Finset
variable [Fintype ι] [Fintype G]
open scoped Classical in
private noncomputable def lifts (f : G →* Q) (v : ι → Q) (H : Subgroup G) :=
  univ.filter fun w : ι → G => f ∘ w = v ∧ generated w ≤ H

private theorem lifts_card (f : G →* Q) (v z : ι → Q)
    (hv : generated v = ⊤) (hz : generated z = ⊤) (H : Subgroup G) :
    (lifts f v H).card = (lifts f z H).card := by
  classical
  by_cases hH : H.map f = ⊤
  · have lift (a : ι → Q) (i : ι) : ∃ x ∈ H, f x = a i := by
      have : a i ∈ H.map f := hH ▸ Subgroup.mem_top _
      exact this
    choose s hs hfs using lift v
    choose t ht hft using lift z
    apply card_bij' (fun w _ i => w i * (s i)⁻¹ * t i)
      (fun w _ i => w i * (t i)⁻¹ * s i)
    · intro w hw
      obtain ⟨hwf, hwH⟩ := (mem_filter.mp hw).2
      apply mem_filter.mpr
      refine ⟨mem_univ _, funext (fun i => ?_), generated_le.mpr (fun i =>
        H.mul_mem (H.mul_mem (generated_le.mp hwH i) (H.inv_mem (hs i))) (ht i))⟩
      have hi : f (w i) = _ := congrFun hwf i
      simp [Function.comp_apply, hi, hfs, hft]
    · intro w hw
      obtain ⟨hwf, hwH⟩ := (mem_filter.mp hw).2
      apply mem_filter.mpr
      refine ⟨mem_univ _, funext (fun i => ?_), generated_le.mpr (fun i =>
        H.mul_mem (H.mul_mem (generated_le.mp hwH i) (H.inv_mem (ht i))) (hs i))⟩
      have hi : f (w i) = _ := congrFun hwf i
      simp [Function.comp_apply, hi, hfs, hft]
    · intro w _
      funext i
      simp [mul_assoc]
    · intro w _
      funext i
      simp [mul_assoc]
  · have empty (a : ι → Q) (ha : generated a = ⊤) : lifts f a H = ∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro w hw
      obtain ⟨hwf, hwH⟩ := (mem_filter.mp hw).2
      apply hH
      apply top_unique
      rw [← ha, ← hwf, ← generated_map]
      exact Subgroup.map_mono hwH
    rw [empty v hv, empty z hz]

/-- Every generating tuple in the quotient has a generating lift of the
same length whenever the domain is generated by a tuple of that length. -/
theorem lift [Finite Q] (f : G →* Q) (hf : Function.Surjective f)
    (a : ι → G) (ha : generated a = ⊤) (z : ι → Q) (hz : generated z = ⊤) :
    ∃ w : ι → G, f ∘ w = z ∧ generated w = ⊤ := by
  classical
  let v := f ∘ a
  have hv : generated v = ⊤ := by
    rw [← generated_map, ha, Subgroup.map_top_of_surjective f hf]
  letI : Finite (Subgroup G) := Finite.of_injective (fun H : Subgroup G => (H : Set G)) SetLike.coe_injective
  letI := Fintype.ofFinite (Subgroup G)
  let exactLifts (t : ι → Q) (H : Subgroup G) :=
    univ.filter fun w : ι → G => f ∘ w = t ∧ generated w = H
  let below (H : Subgroup G) := univ.filter (· ≤ H)
  have sum_counts (t : ι → Q) (H : Subgroup G) :
      (lifts f t H).card = ∑ K ∈ below H, (exactLifts t K).card := by
    rw [card_eq_sum_card_fiberwise (f := generated) (t := below H) (s := lifts f t H)
      (fun w hw => mem_filter.mpr ⟨mem_univ _, (mem_filter.mp hw).2.2⟩)]
    apply sum_congr rfl
    intro K hK
    have hle : K ≤ H := (mem_filter.mp hK).2
    congr 1
    ext w
    simp [lifts, exactLifts]
    intro h _
    exact h ▸ hle
  have counts (H : Subgroup G) : (exactLifts v H).card = (exactLifts z H).card := by
    induction H using WellFoundedLT.induction with
    | ind H ih =>
      have hH : H ∈ below H := mem_filter.mpr ⟨mem_univ _, le_rfl⟩
      have h := lifts_card f v z hv hz H
      rw [sum_counts, sum_counts, ← sum_erase_add _ _ hH, ← sum_erase_add _ _ hH] at h
      apply Nat.add_left_cancel (n := ∑ K ∈ (below H).erase H, (exactLifts v K).card)
      convert h using 2
      apply sum_congr rfl
      intro K hK
      obtain ⟨hne, hmem⟩ := mem_erase.mp hK
      exact ih K (lt_of_le_of_ne (mem_filter.mp hmem).2 hne)
  have hpos : 0 < (exactLifts v ⊤).card := card_pos.mpr
    ⟨a, mem_filter.mpr ⟨mem_univ _, rfl, ha⟩⟩
  rw [counts] at hpos
  obtain ⟨w, hw⟩ := card_pos.mp hpos
  exact ⟨w, (mem_filter.mp hw).2⟩

end Shumyatsky.Gaschutz
