import Shumyatsky.Block
import Shumyatsky.Spectrum

namespace Shumyatsky
namespace Labelled
variable {ι A : Type*} [Group A]

omit [Group A] in
@[ext] theorem extensionality {u v : Labelled ι A} (p : u.perm = v.perm)
    (l : ∀ i, u.label i = v.label i) : u = v := by
  cases u
  cases v
  congr
  exact funext l

instance : Group (Labelled ι A) where
  mul := comp
  one := ⟨1, fun _ => 1⟩
  inv u := ⟨u.perm.symm, fun i => (u.label (u.perm.symm i))⁻¹⟩
  mul_assoc u v w := extensionality rfl (fun _ => mul_assoc _ _ _)
  one_mul u := extensionality (Equiv.ext fun _ => rfl) (fun _ => one_mul _)
  mul_one u := extensionality (Equiv.ext fun _ => rfl) (fun _ => mul_one _)
  inv_mul_cancel u := extensionality (Equiv.ext fun i => u.perm.symm_apply_apply i)
    (fun i => by change (u.label (u.perm.symm (u.perm i)))⁻¹ * u.label i = 1; simp)

theorem mul_perm (u v : Labelled ι A) (i : ι) : (u*v).perm i = u.perm (v.perm i) := rfl
theorem mul_label (u v : Labelled ι A) (i : ι) : (u*v).label i = u.label (v.perm i) * v.label i := rfl

def base (b : ι → A) : Labelled ι A := ⟨1,b⟩

/-- A prescribed outer coset is exactly the freedom to multiply by one kernel
element per source. In a simple block these kernel elements are inner. -/
theorem same_coset {O : Type*} [Group O] (q : A →* O) (u v : Labelled ι A) :
    (u.perm = v.perm ∧ ∀ i, q (u.label i) = q (v.label i)) ↔
      ∃ b : ι → q.ker, u * base (fun i => (b i : A)) = v := by
  constructor
  · rintro ⟨hp,hl⟩
    refine ⟨fun i => ⟨(u.label i)⁻¹ * v.label i, ?_⟩, extensionality hp (fun i => ?_)⟩
    · simp [MonoidHom.mem_ker, hl]
    · change u.label i * ((u.label i)⁻¹ * v.label i) = _
      simp
  · rintro ⟨b,rfl⟩
    exact ⟨rfl, fun i => by change _ = q (u.label i * (b i : A)); simp [MonoidHom.mem_ker.mp (b i).property]⟩

private def stab (r : ι) : Subgroup (Labelled ι A) where
  carrier := {u | u.perm r = r}
  one_mem' := rfl
  mul_mem' {u v} hu hv := by change u.perm (v.perm r) = r; rw [show v.perm r = r from hv]; exact hu
  inv_mem' {u} hu := by change u.perm.symm r = r; exact u.perm.symm_apply_eq.mpr hu.symm

/-- Restriction of the factor stabilizer to its chosen factor. -/
def restriction (r : ι) : stab (A := A) r →* A where
  toFun u := u.val.label r
  map_one' := rfl
  map_mul' u v := by change u.val.label (v.val.perm r) * _ = _; rw [show v.val.perm r = r from v.property]

theorem word_of_walk (u v : Labelled ι A) {i j a}
    (w : Walk u.perm v.perm u.label v.label (fun _ => True) (fun _ => True) i j a) :
    ∃ z ∈ Subgroup.closure {u,v}, z.perm i = j ∧ z.label i = a := by
  induction w with
  | refl i => exact ⟨1, Subgroup.one_mem _, rfl, rfl⟩
  | first _ => exact ⟨u, Subgroup.subset_closure (by simp), rfl, rfl⟩
  | second _ => exact ⟨v, Subgroup.subset_closure (by simp), rfl, rfl⟩
  | rev _ ih =>
    obtain ⟨z,hz,rfl,rfl⟩ := ih
    exact ⟨z⁻¹, Subgroup.inv_mem _ hz, z.perm.symm_apply_apply _, by
      change (z.label (z.perm.symm (z.perm _)))⁻¹ = _; simp⟩
  | comp _ _ ih jh =>
    obtain ⟨z,hz,rfl,rfl⟩ := ih
    obtain ⟨t,ht,rfl,rfl⟩ := jh
    exact ⟨t*z, Subgroup.mul_mem _ ht hz, rfl, rfl⟩

/-- The closed-walk image is a section of the actual subgroup generated by
the pair, so the stabilizer supplies the required order divisibility. -/
theorem loops_card_dvd {G : Type*} [Group G] (ρ : G →* Labelled ι A) (x g : G) (r : ι) :
    Nat.card (Block.loops (ρ x).perm (ρ (g*x*g⁻¹)).perm (ρ x).label (ρ (g*x*g⁻¹)).label r) ∣
      Nat.card (pair x g) := by
  let H := pair x g
  let ψ := ρ.comp H.subtype
  let K := (stab r).comap ψ
  let f : K →* A := (restriction r).comp ((ψ.comp K.subtype).codRestrict (stab r) (fun k => k.property))
  apply dvd_trans (Subgroup.card_dvd_of_le (K := f.range) ?_)
    ((Subgroup.card_range_dvd f).trans K.card_subgroup_dvd_card)
  intro a hw
  obtain ⟨z,hz,hfix,hlabel⟩ := word_of_walk (ρ x) (ρ (g*x*g⁻¹)) hw
  have hm : H.map ρ = Subgroup.closure {ρ x, ρ (g*x*g⁻¹)} := by
    simp [H, pair, MonoidHom.map_closure, Set.image_pair]
  obtain ⟨w,hw,rfl⟩ := (hm.symm ▸ hz : z ∈ H.map ρ)
  exact ⟨⟨⟨w,hw⟩,hfix⟩,hlabel⟩

end Labelled
end Shumyatsky
