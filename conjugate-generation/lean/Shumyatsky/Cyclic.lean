import Shumyatsky.Spectrum
import Shumyatsky.Gaschutz
import Mathlib.GroupTheory.SpecificGroups.Cyclic

namespace Shumyatsky

open Subgroup

private theorem generated_one {T : Type*} [Group T] (w : Unit → T) :
    Gaschutz.generated w = zpowers (w ()) := by
  have h : Set.range w = {w ()} := by
    ext x
    exact ⟨fun ⟨i, h⟩ => by cases i; exact h.symm, fun h => ⟨(), h.symm⟩⟩
  rw [Gaschutz.generated, h, ← zpowers_eq_closure]

private theorem pair_sup {G : Type*} [Group G] (x g : G) :
    pair x g = zpowers x ⊔ (zpowers x).map (MulAut.conj g).toMonoidHom := by
  rw [MonoidHom.map_zpowers, zpowers_eq_closure, zpowers_eq_closure, ← Subgroup.closure_union]
  simp [pair, MulAut.conj_apply, Set.pair_comm]

/-- In an abelian quotient the first element of a conjugate generating
pair generates the quotient. -/
theorem image_generator {G Q : Type*} [Group G] [CommGroup Q] (f : G →* Q)
    (hf : Function.Surjective f) {x g : G} (h : pair x g = ⊤) : zpowers (f x) = ⊤ := by
  have hh := pair_map f x g
  rw [h, Subgroup.map_top_of_surjective _ hf] at hh
  simpa [pair, zpowers_eq_closure, mul_comm (f g) (f x)] using hh.symm

/-- Once two conjugates generate, both desired cosets can be prescribed in
a cyclic quotient. Apply the one-entry lifting lemma inside the cyclic group
generated by the original first element. -/
theorem prescribe_cosets {G Q : Type*} [Group G] [CommGroup Q] [Finite G] [Finite Q]
    (f : G →* Q) (hf : Function.Surjective f) (c d : Q) (hc : zpowers c = ⊤)
    {a g : G} (ha : pair a g = ⊤) :
    ∃ x h : G, f x = c ∧ f h = d ∧ pair x h = ⊤ := by
  classical
  let A := zpowers a
  let a' : A := ⟨a, mem_zpowers a⟩
  let q := f.comp A.subtype
  have hA : zpowers a' = ⊤ := by
    apply Subgroup.map_injective A.subtype_injective
    rw [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, A.range_subtype]
    rfl
  have hq : Function.Surjective q := by
    intro y
    have hy : y ∈ A.map f := by
      rw [show A = zpowers a from rfl, MonoidHom.map_zpowers, image_generator f hf ha]
      trivial
    obtain ⟨x, hx, he⟩ := hy
    exact ⟨⟨x, hx⟩, he⟩
  letI := Fintype.ofFinite A
  obtain ⟨w, hw, hgen⟩ := Gaschutz.lift q hq (fun _ : Unit => a')
    ((generated_one _).trans hA) (fun _ : Unit => c) ((generated_one _).trans hc)
  let x : G := w ()
  have hx : f x = c := congrFun hw ()
  have hcyc : zpowers x = A := by
    have e := congrArg (Subgroup.map A.subtype) ((generated_one w).symm.trans hgen)
    simpa [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map] using e
  obtain ⟨j, hj⟩ := (show (f g)⁻¹ * d ∈ zpowers c by rw [hc]; trivial)
  refine ⟨x, g * x ^ j, hx, by simp [hx, hj], ?_⟩
  have he : (g * x ^ j) * x * (g * x ^ j)⁻¹ = g * x * g⁻¹ := by
    have hcomm := (Commute.refl x).zpow_left j
    simp [mul_assoc, hcomm.eq]
  change Subgroup.closure {x, (g * x ^ j) * x * (g * x ^ j)⁻¹} = ⊤
  rw [he]
  change pair x g = ⊤
  rw [pair_sup, hcyc, ← ha, pair_sup]

end Shumyatsky
