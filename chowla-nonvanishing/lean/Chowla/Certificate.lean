import Chowla.Rows
import Mathlib.Analysis.Convolution
import Mathlib.Analysis.Fourier.FourierTransform
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Data.Finsupp.Multiset
import Mathlib.Order.Partition.Finpartition

namespace Chowla

open Filter MeasureTheory MvPolynomial
open scoped BigOperators Convolution FourierTransform

/-- Fourier transform `∫ f(x) exp(-2πixξ) dx`, for the real test functions of the paper. -/
noncomputable def fourier (f : ℝ → ℝ) : ℝ → ℂ := 𝓕 (fun x : ℝ => (f x : ℂ))

/-- The real inverse Fourier transform of an even real profile. -/
noncomputable def inverseProfile (h : ℝ → ℝ) (x : ℝ) : ℝ :=
  (𝓕⁻ (fun u : ℝ => (h u : ℂ)) x).re

/-- A profile in §2.1 is bounded, measurable, even and compactly supported. -/
def IsProfile (h : ℝ → ℝ) : Prop :=
  Measurable h ∧ Function.Even h ∧ Bornology.IsBounded (Set.range h) ∧ HasCompactSupport h

/-- A bound on the essential support radius in §2.1. -/
def HasRadiusAtMost (h : ℝ → ℝ) (b : ℝ) : Prop :=
  0 ≤ b ∧ ∀ᵐ u ∂volume, u ∉ Set.Icc (-b) b → h u = 0

noncomputable def radius (h : ℝ → ℝ) : ℝ := sInf {b | HasRadiusAtMost h b}

/-- The odd profile `u ↦ sgn(u) h(u)`. -/
noncomputable def oddProfile (h : ℝ → ℝ) (u : ℝ) : ℝ :=
  if u < 0 then -h u else if 0 < u then h u else 0

noncomputable def convolve (h g : ℝ → ℝ) : ℝ → ℝ := h ⋆ g

noncomputable def convolutionList : List (ℝ → ℝ) → ℝ → ℝ
  | [] => 0
  | [h] => h
  | h :: g :: gs => convolve h (convolutionList (g :: gs))

/-- The convolution tail in Definition 5, with arguments given by their Fourier profiles. -/
noncomputable def delta (hs : List (ℝ → ℝ)) : ℝ :=
  -((-2 : ℝ) ^ hs.length) / 2 *
    ∫ u in Set.Ioi (1 : ℝ), convolutionList (hs.map oddProfile) u

/-- The restricted cumulant in Definition 5. The singleton formula is used on profiles continuous
at zero. The empty list has no block in the moment expansion. -/
noncomputable def cumulant : List (ℝ → ℝ) → ℝ
  | [] => 0
  | [h] => h 0 - ∫ u in (0 : ℝ)..1, h u
  | [h, g] => (2 * ∫ u : ℝ, |u| * h u * g u) + delta [h, g]
  | h :: g :: k :: hs => delta (h :: g :: k :: hs)

/-- Equation (3) over labelled positions. Ordering the positions within each block gives the
list argument of the restricted cumulant. -/
noncomputable def modelMoment {n : ℕ} (h : Fin n → ℝ → ℝ) : ℝ := by
  classical
  exact ∑ π : Finpartition (Finset.univ : Finset (Fin n)),
    ∏ B ∈ π.parts, cumulant ((B.sort (· ≤ ·)).map h)

/-- Formal linear statistics indexed by their Fourier profiles. The paper uses the subalgebra
generated by the bounded, measurable, even profiles continuous at zero with compact support. -/
abbrev Model := MvPolynomial (ℝ → ℝ) ℝ

noncomputable def stat (h : ℝ → ℝ) : Model := MvPolynomial.X h

/-- Model expectation on polynomials, by the moment of each monomial with its multiplicities. -/
noncomputable def modelExpectation (P : Model) : ℝ := by
  classical
  exact ∑ m ∈ P.support,
    let hs := m.toMultiset.toList
    coeff m P * modelMoment hs.get

noncomputable def rectangle (a : ℝ) : ℝ → ℝ :=
  (Set.Icc (-a) a).indicator (fun _ => 1)

noncomputable def centered (h : ℝ → ℝ) : Model :=
  stat h - MvPolynomial.C (cumulant [h])

/-- The Wick polynomial of a list of profiles. Each partition into pairs and singletons
encodes a partial matching, with its singletons the unmatched positions. -/
noncomputable def wick (hs : List (ℝ → ℝ)) : Model := by
  classical
  exact ∑ π ∈ (Finset.univ : Finset (Finpartition (Finset.univ : Finset (Fin hs.length)))).filter
            (fun π => ∀ B ∈ π.parts, B.card ≤ 2),
      ∏ B ∈ π.parts,
        match (B.sort (· ≤ ·)).map hs.get with
        | [h] => centered h
        | [h, g] => MvPolynomial.C (-cumulant [h, g])
        | _ => 1

/-- Consecutive Legendre polynomials `(Pₙ(x), Pₙ₊₁(x))`, by the three-term recurrence. -/
noncomputable def legendrePair (x : ℝ) : ℕ → ℝ × ℝ
  | 0 => (1, x)
  | n + 1 =>
    let (p, q) := legendrePair x n
    (q, ((2 * (n : ℝ) + 3) * x * q - ((n : ℝ) + 1) * p) / ((n : ℝ) + 2))

noncomputable def legendre (n : ℕ) (x : ℝ) : ℝ := (legendrePair x n).1

/-- The coefficients are listed in order of the positive even degrees. -/
noncomputable def legendreProfile (s : ℝ) (c : List ℝ) : ℝ → ℝ :=
  (Set.Icc (-s) s).indicator fun u =>
    ∑ j : Fin c.length, c.get j * legendre (2 * (j.val + 1)) (u / s)

noncomputable def H : ℝ → ℝ :=
  (Set.Icc (-1) 1).indicator fun u =>
    let A := (1 + Real.cot (1 / 4)) / 8
    A * Real.cos (|u| / 2) + (1 / 4 - A) * Real.sin (|u| / 2)

noncomputable def G : ℝ → ℝ := inverseProfile H

structure Row where
  widths : List ℝ
  profile : ℝ → ℝ

abbrev Amplitude := List Row

def Row.Admissible (k : Row) : Prop :=
  (∀ a ∈ k.widths, a ∈ Set.Ioo (0 : ℝ) 1) ∧ IsProfile k.profile ∧
    (∫ u : ℝ, k.profile u) = 0 ∧ radius k.profile ≤ 1 - k.widths.sum

/-- The conditions of Definition 20. -/
def IsAmplitude (F : Amplitude) : Prop := ∀ k ∈ F, k.Admissible

noncomputable def wickRow (k : Row) : Model := wick (k.widths.map rectangle)

noncomputable def amplitudeAt (F : Amplitude) (x : ℝ) : Model :=
  (F.map fun k => MvPolynomial.C (inverseProfile k.profile x) * wickRow k).sum

/-- The model product of `G` with itself. -/
noncomputable def innerGG : ℝ := cumulant [convolve H H]

/-- The model product of `G` with one row, using `H * η` for the product's Fourier profile. -/
noncomputable def innerGRow (k : Row) : ℝ :=
  modelExpectation (stat (convolve H k.profile) * wickRow k)

/-- The model product of two rows, using `ηₖ * ηₗ` for the product's Fourier profile. -/
noncomputable def innerRow (k l : Row) : ℝ :=
  modelExpectation (stat (convolve k.profile l.profile) * wickRow k * wickRow l)

noncomputable def inner_G (F : Amplitude) : ℝ := (F.map innerGRow).sum

noncomputable def inner (F F' : Amplitude) : ℝ :=
  (F.map fun k => (F'.map (innerRow k)).sum).sum

noncomputable def Rows.RowData.toRow (r : Rows.RowData) : Row :=
  let A := r.widths.map (fun a : ℚ => (a : ℝ))
  ⟨A, fun u => (r.weight : ℝ) * legendreProfile (1 - A.sum) (r.coefficients.map (↑)) u⟩

/-- The rational rows of the final amplitude of §8. The inherited rows carry the stage-five
factor, and the later rows keep their own paper weights. -/
def finalRows : List Rows.RowData :=
  let inherited := Rows.r0 ++ Rows.r1Grid ++ Rows.r1Modes ++ Rows.r2 ++ Rows.r3 ++ Rows.r4 ++ Rows.r5
  (inherited.map fun r => { r with weight := Rows.inheritedWeight * r.weight }) ++
    Rows.r6 ++ Rows.r7 ++ Rows.r8 ++ Rows.r9

noncomputable def F₈ : Amplitude := finalRows.map Rows.RowData.toRow

def CertificateStatement : Prop :=
  0.9453419890 < (19 - Real.cot (1 / 4)) / 16 + inner_G F₈ - inner F₈ F₈ / 2

end Chowla
