def profile : Array Nat := (Array.range 2049).map ordinate

theorem profile_size : profile.size = 2049 := by simp [profile]

@[simp] theorem get_profile (i : Nat) (hi : i < 2049) : profile[i]'(by simpa only [profile_size] using hi) = ordinate i := by
  simp [profile]

end HadwigerNelson.CompleteWave
