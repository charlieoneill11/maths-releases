theorem right_knot_ok (i : Nat) (hi : i ≤ 512) : KnotOK true rightKnot 512 i := by
  apply of_blocks _ _ _ _ i hi
  intro k hk
  match k with
  | 0 => exact rightBlock0
  | 1 => exact rightBlock1
  | 2 => exact rightBlock2
  | 3 => exact rightBlock3
  | 4 => exact rightBlock4
  | 5 => exact rightBlock5
  | 6 => exact rightBlock6
  | 7 => exact rightBlock7
  | 8 => exact rightBlock8
  | 9 => exact rightBlock9
  | 10 => exact rightBlock10
  | 11 => exact rightBlock11
  | 12 => exact rightBlock12
  | 13 => exact rightBlock13
  | 14 => exact rightBlock14
  | 15 => exact rightBlock15
  | 16 => exact rightBlock16
  | k+17 => omega

