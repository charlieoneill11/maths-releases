def leftKnot (i : Nat) : Nat × Nat := leftData[i]?.getD (0,0)
def rightKnot (i : Nat) : Nat × Nat := (chunk (i/32))[i%32]?.getD (0,0)

def leftKnots : Array (Nat × Nat) := (Array.range 37).map leftKnot
def rightKnots : Array (Nat × Nat) := (Array.range 513).map rightKnot

@[simp] theorem knot_counts : leftKnots.size = 37 ∧ rightKnots.size = 513 := by simp [leftKnots,rightKnots]
@[simp] theorem get_leftKnots (i : Nat) (hi : i < 37) : leftKnots[i]'(by simpa [leftKnots] using hi) = leftKnot i := by simp [leftKnots]
@[simp] theorem get_rightKnots (i : Nat) (hi : i < 513) : rightKnots[i]'(by simpa [rightKnots] using hi) = rightKnot i := by simp [rightKnots]

/-- Exact integer inequalities on a knot, its next segment, and its reflected partner. -/
def KnotOK (isRight : Bool) (t : Nat → Nat × Nat) (n i : Nat) : Prop :=
  let h := (t i).1
  let v := (t i).2
  let k := (t (i+1)).1
  let w := (t (i+1)).2
  h+(t (n-i)).1 = scale/2 ∧ v = (t (n-i)).2 ∧
  (if isRight then h = i*976562500 ∧ 4*scale < 5*v ∧ v < scale ∧
    (i ≤ n/2 → v+(t (i+n/2)).2 = 2*xInt)
   else (i ≤ 17 → h = i*540000000) ∧ (i=18 → h=scale/4) ∧
     5*v < scale ∧ (y0Int ≤ h → h ≤ scale/2-y0Int → v = 0)) ∧
  (i<n → h < k ∧ w+h ≤ v+k ∧ v+h ≤ w+k ∧
    (h < scale/4 → if isRight then v ≤ w else w ≤ v))

instance (b : Bool) (t : Nat → Nat × Nat) (n i : Nat) : Decidable (KnotOK b t n i) := by
  unfold KnotOK
  cases b <;> infer_instance

private def checkBlock (b : Bool) (t : Nat → Nat × Nat) (n k : Nat) :=
  (List.range 32).all (fun j => decide (32*k+j ≤ n → KnotOK b t n (32*k+j)))

private theorem of_blocks (b : Bool) (t : Nat → Nat × Nat) (n : Nat)
    (checks : ∀ k ≤ n/32, checkBlock b t n k = true) (i : Nat) (hi : i ≤ n) : KnotOK b t n i := by
  have ck := checks (i/32) (Nat.div_le_div_right hi)
  have r := List.all_eq_true.mp ck (i%32) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have e : 32*(i/32)+i%32=i := by omega
  simpa only [e] using of_decide_eq_true r (by omega)

private theorem leftBlock0 : checkBlock false leftKnot 36 0 = true := by decide +kernel
private theorem leftBlock1 : checkBlock false leftKnot 36 1 = true := by decide +kernel

theorem left_knot_ok (i : Nat) (hi : i ≤ 36) : KnotOK false leftKnot 36 i := by
  apply of_blocks _ _ _ _ i hi
  intro k hk
  match k with
  | 0 => exact leftBlock0
  | 1 => exact leftBlock1
  | k+2 => omega

private theorem rightBlock0 : checkBlock true rightKnot 512 0 = true := by decide +kernel
private theorem rightBlock1 : checkBlock true rightKnot 512 1 = true := by decide +kernel
private theorem rightBlock2 : checkBlock true rightKnot 512 2 = true := by decide +kernel
private theorem rightBlock3 : checkBlock true rightKnot 512 3 = true := by decide +kernel
