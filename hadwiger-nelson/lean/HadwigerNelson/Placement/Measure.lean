import HadwigerNelson.Placement.Coordinates
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability

/-! The probability law for rotations and translations in Definition 7. -/

open MeasureTheory Set
open scoped ENNReal

namespace HadwigerNelson.Placement

noncomputable section

/-- The normalized interval measure on the fundamental parameter interval. Endpoints have
zero measure. It is a probability measure when `T` is positive. -/
def uniformInterval (T : ℝ) : Measure ℝ :=
  (ENNReal.ofReal T)⁻¹ • volume.restrict (Ioc 0 T)

theorem uniformInterval_probability {T : ℝ} (hT : 0 < T) : IsProbabilityMeasure (uniformInterval T) := by
  constructor
  simp only [uniformInterval, Measure.smul_apply, Measure.restrict_apply_univ, Real.volume_Ioc,
    sub_zero, smul_eq_mul]
  exact ENNReal.inv_mul_cancel (ENNReal.ofReal_ne_zero_iff.mpr hT) ENNReal.ofReal_ne_top

instance (T : ℝ) : IsFiniteMeasure (uniformInterval T) := by
  by_cases h : 0 < T
  · letI := uniformInterval_probability h
    infer_instance
  · have hempty : Ioc (0:ℝ) T = ∅ := Ioc_eq_empty h
    simp only [uniformInterval, hempty, Measure.restrict_empty, smul_zero]
    infer_instance

/-- Coordinates in a fundamental rectangle of the lattice generated by `(2x,3H/2)` and `(0,3H)`. -/
def translationLaw (W : Wave.Datum) : Measure Translation :=
  (uniformInterval (2 * W.x)).prod (uniformInterval (3 * Wave.H))

/-- The angle is independent of both translation coordinates. -/
def law (W : Wave.Datum) : Measure Sample :=
  (uniformInterval (2 * Real.pi)).prod (translationLaw W)

instance (W : Wave.Datum) : IsProbabilityMeasure (translationLaw W) := by
  have hx := W.x_bounds.1
  letI := uniformInterval_probability (show 0 < 2 * W.x by linarith)
  letI := uniformInterval_probability (show 0 < 3 * Wave.H by linarith [Wave.H_pos])
  unfold translationLaw
  infer_instance

instance (W : Wave.Datum) : IsProbabilityMeasure (law W) := by
  letI := uniformInterval_probability (show 0 < 2 * Real.pi by linarith [Real.pi_pos])
  unfold law
  infer_instance

end
end HadwigerNelson.Placement
