def rowCount (p : Bool) := if p then 64 else 4

def row (p : Bool) (i : Fin (rowCount p)) : Row := match p with
  | false => cases1122.get i
  | true => cases1123.get i

def rowMask (p : Bool) (i : Fin (rowCount p)) : Nat := (row p i).mask

def frame (p : Bool) : Frame :=
  let gap : Fin 4 → Nat := ![1,1,2,if p then 3 else 2]
  ⟨gap, fun k => -(gap k : Height)⟩

def maskTable (p : Bool) : Std.HashSet SlabJoin.FrameMask :=
  Std.HashSet.ofArray ((Array.finRange (rowCount p)).map fun i => ⟨rowMask p i⟩)

theorem maskTable_sound (p : Bool) (bits : Nat) (h : (maskTable p).contains ⟨bits⟩ = true) :
    ∃ i, bits = rowMask p i := by
  simp only [maskTable, Std.HashSet.ofArray_eq_ofList, Std.HashSet.contains_ofList,
    List.contains_iff_mem, Array.mem_toList_iff, Array.mem_map] at h
  obtain ⟨i, _, hi⟩ := h
  exact ⟨i, (congrArg SlabJoin.FrameMask.bits hi).symm⟩

